{
  "name": "startup-simulator",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "balance": "tsx tools/balance/run.ts",
    "share": "npm run build && node tools/singlefile.mjs",
    "server:build": "esbuild tools/ai-server/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/server.mjs --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "deploy": "bash tools/deploy.sh"
  },
  "dependencies": {
    "i18next": "^26.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "three": "^0.181.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
